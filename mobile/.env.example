# Pickky mobile environment
# Copy to .env and adjust. All values are EXPO_PUBLIC_* (inlined at bundle time, safe for the client).

# REST base URL of the existing Go backend
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# WebSocket endpoint of the existing Go backend
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws

# API mode:
#   live  -> talk to the real backend only
#   mock   -> local in-process development backend (used while backend endpoints are not yet deployed)
EXPO_PUBLIC_API_MODE=mock

# Google Maps API key (Android SDK crashes without it).
# Leave unset to use the built-in map placeholder; to enable real maps:
#   1. create a key in Google Cloud (Maps SDK for Android), 2) set it here,
#   3) run `npx expo prebuild -p android`, 4) rebuild the app.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
