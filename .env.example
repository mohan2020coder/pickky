PORT=8080
APP_ENV=dev
# Log verbosity: debug | info | warn | error (default info).
LOG_LEVEL=info
# Per-request access logs: on | off (default: on when APP_ENV=dev, off otherwise).
HTTP_LOGS=on
DB_HOST=postgres
DB_PORT=5433
DB_NAME=pickky
DB_USER=pickky
DB_PASSWORD=pickky
DB_SSLMODE=disable
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
JWT_SECRET=devsecret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ALLOWED_ORIGINS=*
PRICING_DEFAULT_BASE_MINOR=4000
PRICING_PER_KM_MINOR=1500
OTP_TTL=300s
PRESENCE_TTL=5m
LOCATION_TTL=5m
LOCK_TTL=5s
OFFER_TTL=30s
RPC_DEADLINE=5s
